<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.smartcare.mapper.BizAlertRuleMapper">
    
    <resultMap type="BizAlertRule" id="BizAlertRuleResult">
        <result property="ruleId"    column="rule_id"    />
        <result property="ruleName"    column="rule_name"    />
        <result property="deviceType"    column="device_type"    />
        <result property="metricType"    column="metric_type"    />
        <result property="conditionOp"    column="condition_op"    />
        <result property="thresholdValue"    column="threshold_value"    />
        <result property="alertLevel"    column="alert_level"    />
        <result property="status"    column="status"    />
        <result property="alertType"    column="alert_type"    />
        <result property="createTime"    column="create_time"    />
        <result property="remark"    column="remark"    />
    </resultMap>

    <sql id="selectBizAlertRuleVo">
        select rule_id, rule_name, device_type, metric_type, condition_op, threshold_value, alert_level, status, alert_type, create_time, remark from biz_alert_rule
    </sql>

    <select id="selectBizAlertRuleList" parameterType="BizAlertRule" resultMap="BizAlertRuleResult">
        <include refid="selectBizAlertRuleVo"/>
        <where>  
            <if test="ruleName != null  and ruleName != ''"> and rule_name like concat('%', #{ruleName}, '%')</if>
            <if test="deviceType != null  and deviceType != ''"> and device_type = #{deviceType}</if>
            <if test="metricType != null  and metricType != ''"> and metric_type = #{metricType}</if>
            <if test="conditionOp != null  and conditionOp != ''"> and condition_op = #{conditionOp}</if>
            <if test="thresholdValue != null  and thresholdValue != ''"> and threshold_value = #{thresholdValue}</if>
            <if test="alertLevel != null "> and alert_level = #{alertLevel}</if>
            <if test="status != null  and status != ''"> and status = #{status}</if>
            <if test="alertType != null  and alertType != ''"> and alert_type = #{alertType}</if>
        </where>
    </select>
    
    <select id="selectBizAlertRuleByRuleId" parameterType="Long" resultMap="BizAlertRuleResult">
        <include refid="selectBizAlertRuleVo"/>
        where rule_id = #{ruleId}
    </select>

    <insert id="insertBizAlertRule" parameterType="BizAlertRule" useGeneratedKeys="true" keyProperty="ruleId">
        insert into biz_alert_rule
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="ruleName != null and ruleName != ''">rule_name,</if>
            <if test="deviceType != null and deviceType != ''">device_type,</if>
            <if test="metricType != null and metricType != ''">metric_type,</if>
            <if test="conditionOp != null and conditionOp != ''">condition_op,</if>
            <if test="thresholdValue != null and thresholdValue != ''">threshold_value,</if>
            <if test="alertLevel != null">alert_level,</if>
            <if test="status != null and status != ''">status,</if>
            <if test="alertType != null and alertType != ''">alert_type,</if>
            <if test="createTime != null">create_time,</if>
            <if test="remark != null">remark,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="ruleName != null and ruleName != ''">#{ruleName},</if>
            <if test="deviceType != null and deviceType != ''">#{deviceType},</if>
            <if test="metricType != null and metricType != ''">#{metricType},</if>
            <if test="conditionOp != null and conditionOp != ''">#{conditionOp},</if>
            <if test="thresholdValue != null and thresholdValue != ''">#{thresholdValue},</if>
            <if test="alertLevel != null">#{alertLevel},</if>
            <if test="status != null and status != ''">#{status},</if>
            <if test="alertType != null and alertType != ''">#{alertType},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="remark != null">#{remark},</if>
         </trim>
    </insert>

    <update id="updateBizAlertRule" parameterType="BizAlertRule">
        update biz_alert_rule
        <trim prefix="SET" suffixOverrides=",">
            <if test="ruleName != null and ruleName != ''">rule_name = #{ruleName},</if>
            <if test="deviceType != null and deviceType != ''">device_type = #{deviceType},</if>
            <if test="metricType != null and metricType != ''">metric_type = #{metricType},</if>
            <if test="conditionOp != null and conditionOp != ''">condition_op = #{conditionOp},</if>
            <if test="thresholdValue != null and thresholdValue != ''">threshold_value = #{thresholdValue},</if>
            <if test="alertLevel != null">alert_level = #{alertLevel},</if>
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="alertType != null and alertType != ''">alert_type = #{alertType},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        where rule_id = #{ruleId}
    </update>

    <delete id="deleteBizAlertRuleByRuleId" parameterType="Long">
        delete from biz_alert_rule where rule_id = #{ruleId}
    </delete>

    <delete id="deleteBizAlertRuleByRuleIds" parameterType="String">
        delete from biz_alert_rule where rule_id in 
        <foreach item="ruleId" collection="array" open="(" separator="," close=")">
            #{ruleId}
        </foreach>
    </delete>
</mapper>